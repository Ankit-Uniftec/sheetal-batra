/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
schema.sql
docs
db

# local data dumps / exports — may contain customer PII, never commit
data.json
response.json
delivery_report_*.csv

# Supabase — track edge function SOURCE (it's deployed code that exists
# nowhere else), but never secrets, local state or generated temp files.
# Function secrets live in Supabase's own config and are read at runtime via
# Deno.env.get(), so the source itself carries no credentials.
supabase/*
!supabase/functions/
supabase/functions/*/.env*
supabase/.branches
supabase/.temp
supabase/.env*
.dup/

# Working notes and API dumps. Contains real customer PII (names, phones,
# addresses from live Shopify orders) and a live project anon JWT in
# prod-cron.sql. Untracked until now only because files were staged by
# name -- one `git add -A` would have committed the lot.
scratchpad/

# Ad-hoc data exports/imports dropped in the repo root while working (product
# catalogue dumps, B2B and Shopify spreadsheets, colour-code PDFs). These are
# live production data -- real SKUs, pricing and customer-facing content -- and
# are regenerated on demand, so they are working files, not source. Same reason
# delivery_report_*.csv above is ignored.
/*.xlsx
/*.csv
/*.pdf
